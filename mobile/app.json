{
  "expo": {
    "name": "Laystra",
    "slug": "laystra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vicrojasmunoz.laystra",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fd97440d-bcf4-4ab7-bb62-7d916b0e0d54"
      }
    },
    "owner": "vicrojass",
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Laystra usa el contador de pasos de tu iPhone para mostrar tus pasos diarios y guardarlos en tu historial."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Laystra necesita acceder a tus fotos para que puedas elegir tu foto de perfil. La foto se queda solo en tu iPhone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
